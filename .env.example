# NOVUS AI Provider Configuration
# Copy this file to .env.local and fill in real values.
# Never commit real API keys to the repository.

# --- NVIDIA NIM (primary provider) ---
# Get an API key at https://build.nvidia.com
NOVUS_AI_NIM_API_KEY=

# Optional override of the NIM base URL (default: https://integrate.api.nvidia.com/v1)
NOVUS_AI_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Request timeout in milliseconds (default: 30000).
# The chat model reasons before answering, so long turns can exceed the
# default. 120000 leaves room for a full reasoning budget.
NOVUS_AI_NIM_TIMEOUT_MS=120000

# Optional default model alias for workflows that do not specify one
NOVUS_AI_NIM_DEFAULT_MODEL=nova-reasoning

# --- General AI settings ---
# Default provider id (default: nim)
NOVUS_AI_DEFAULT_PROVIDER=nim

# Default data sensitivity: public | internal | sensitive | restricted
NOVUS_AI_DEFAULT_SENSITIVITY=internal

# Enable streaming responses (default: true)
NOVUS_AI_ENABLE_STREAMING=true

# Max retry attempts on retryable errors (default: 2)
NOVUS_AI_MAX_RETRIES=2
